# Crucible — every environment variable the server reads (validated by src/server/config/parse.ts). Copy to .env.local.
# Crucible runs on PostgreSQL only. On a developer machine: `npm run db:local` creates the database, then `npm run db:migrate`.

# ── Database (required) ─────────────────────────────────────────────────────────────────────────────────────────────────
# Shared EPC2I server: postgres://crucible_app:<CRUCIBLE_APP_PASSWORD>@<host>:5432/epc2i (schema `crucible`, created by Matrix).
DATABASE_URL=postgres://crucible_app:crucible-dev@127.0.0.1:5432/epc2i
# Connections per process (default 10).
DATABASE_POOL_MAX=
# Seed of an EMPTY schema at `npm run db:migrate`: demo (demonstration data set) or production (nothing but the record).
CRUCIBLE_SEED=demo

# ── Sign-in ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# demo (default: "View as", never exposed without HTTP authentication) | entra (Microsoft Entra ID).
CRUCIBLE_AUTH=
# ≥ 32 characters (entra).
CRUCIBLE_SESSION_SECRET=
# Session lifetime in hours (default 12).
CRUCIBLE_SESSION_HOURS=
# E-mails given the administrator role at their first sign-in (bootstrap of a new database), comma-separated.
CRUCIBLE_ADMIN_EMAILS=
ENTRA_TENANT_ID=
ENTRA_ISSUER=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_POST_LOGOUT_REDIRECT_URI=

# ── Sibling applications (public URLs, inlined at build time) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_KEYSTONE_URL=
NEXT_PUBLIC_CODEX_URL=
NEXT_PUBLIC_VIGIE_URL=

# ── Operations ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# Business clock: unset = the real date; "YYYY-MM-DD" pins it (demonstrations, tests).
CRUCIBLE_CLOCK=
# Local files of this instance (default ./.data; /data in the image).
CRUCIBLE_DATA_DIR=
# debug | info (default) | warn | error | silent ; json (production default) | pretty.
LOG_LEVEL=
LOG_FORMAT=

# ── Matrix (data catalogue) ─────────────────────────────────────────────────────────────────────────────────────────────
# Crucible declares its tables after each migration and at start-up; unset = nothing sent.
MATRIX_URL=
MATRIX_TOKEN=
# Optional: also writes the declaration to <dir>/crucible.json.
MATRIX_DECLARATIONS_DIR=

# ── Backups (npm run worker / npm run backup) ──────────────────────────────────────────────────────────────────────────
# Folder of the pg_dump backups of the schema; unset = no scheduled backup.
CRUCIBLE_BACKUP_DIR=
# Minutes between two backups (default 1440) and days kept (default 14).
CRUCIBLE_BACKUP_EVERY_MIN=
CRUCIBLE_BACKUP_RETENTION_DAYS=

# ── E-mail of the notifications (npm run worker) ───────────────────────────────────────────────────────────────────────
# "none" (default: the bell only) or "file": one .eml file per message in CRUCIBLE_MAIL_DIR (tests, or a relay picking them up).
CRUCIBLE_MAIL_TRANSPORT=
CRUCIBLE_MAIL_DIR=
# Sender address (default crucible@epc2i.example).
CRUCIBLE_MAIL_FROM=

# ── AI assistant (spec 04, I-3) ────────────────────────────────────────────────────────────────────────────────────────
# "off" (default): the assistant answers with rule-based templates; nothing leaves Crucible. "claude": Claude (Anthropic)
# answers — only once the IT department has validated the provider and the hosting region. The questions and the facts the
# assistant looks up are then sent to Anthropic (no confidential project, no personal data but the people planned, I-4).
CRUCIBLE_AI=
# Required with CRUCIBLE_AI=claude (secret).
ANTHROPIC_API_KEY=
# Model id (default claude-opus-5-5); "off" drops the server-side refusal fallback (default on).
CRUCIBLE_AI_MODEL=
CRUCIBLE_AI_FALLBACKS=
